APP_ENV=dev
SERVER_PORT=:8080
PUBLIC_API_URL=http://localhost:8080/api
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
AUTH_LOGIN_LIMIT=30
AUTH_REGISTRATION_LIMIT=10
AUTH_RESEND_LIMIT=10

# Start storage with root Compose. Copy keys from the root .env locally.
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=shopping-manager-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REQUEST_TIMEOUT=30s
# Executable names or absolute local paths, without shell arguments.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=products_db
DB_SSLMODE=disable

# Independent random secrets, at least 32 bytes each. Required before startup.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ACTIVATION_TTL=24h
ACTIVATION_RESEND_INTERVAL=60s
ACTIVATION_MAIL_TIMEOUT=10s

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your password
SMTP_FROM=your_email@gmail.com
SMTP_AUTH_ENABLED=true
SMTP_TLS_REQUIRED=true
