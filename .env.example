# Local Compose stack; separate from backend/.env and frontend/.env.
APP_PORT=5173
DB_PORT=5432
MAILPIT_PORT=8025
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=products_db
JWT_ACCESS_SECRET=GENERATE_ACCESS_SECRET
JWT_REFRESH_SECRET=GENERATE_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
ACTIVATION_TTL=24h
ACTIVATION_RESEND_INTERVAL=60s
ACTIVATION_MAIL_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXIES=
AUTH_LOGIN_LIMIT=30
AUTH_REGISTRATION_LIMIT=10
AUTH_RESEND_LIMIT=10

# Private local SeaweedFS
S3_PORT=8333
S3_BUCKET=shopping-manager-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=GENERATE_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=GENERATE_S3_SECRET
S3_REQUEST_TIMEOUT=30s
